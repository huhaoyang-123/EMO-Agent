    {"name": "2025Q3", "train_end": "2025-06-30", "evaluation_end": "2025-09-30", "period": "primary_2025"},
    {"name": "2025Q4", "train_end": "2025-09-30", "evaluation_end": "2025-12-31", "period": "primary_2025"},
    {"name": "2026Q1", "train_end": "2025-12-31", "evaluation_end": "2026-03-31", "period": "diagnostic_2026H1"},
    {"name": "2026Q2", "train_end": "2026-03-31", "evaluation_end": "2026-06-30", "period": "diagnostic_2026H1"}
  ]
